{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["plugins"],
  "properties": {
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "description", "scenario", "mcp_servers", "skills"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            }
          },
          "scenario": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            }
          },
          "upgrade_to": { "type": "string" },
          "upgrade_description": {
            "type": "object",
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            }
          },
          "mcp_servers": { "type": "array", "items": { "type": "string" } },
          "skills": { "type": "array", "items": { "type": "string" } },
          "icon": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
