{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["servers"],
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "description", "status", "category", "region", "github"],
        "properties": {
          "slug": { "type": "string", "pattern": "^mcp-[a-z0-9-]+$" },
          "name": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            }
          },
          "description": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": {
              "en": { "type": "string" },
              "zh": { "type": "string" }
            }
          },
          "status": { "type": "string", "enum": ["released", "coming-soon", "planned"] },
          "category": {
            "type": "string",
            "enum": ["ecommerce", "payment", "analytics", "communication", "data", "crm", "restaurant", "gov", "marketing", "finance", "manufacturing", "ops", "customer-service", "media", "methodology", "theory", "algorithm"]
          },
          "region": { "type": "string", "enum": ["global", "taiwan", "sea", "japan"] },
          "github": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+" },
          "tools_count": { "type": "integer", "minimum": 0 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "upgrade_to": { "type": "string" },
          "plugins": { "type": "array", "items": { "type": "string" } },
          "api_docs": { "type": "string", "pattern": "^https://" },
          "icon": { "type": "string" },
          "maintainer": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
