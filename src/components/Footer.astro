---
---
<footer class="relative border-t border-border mt-20">
  <!-- Gradient overlay from bottom -->
  <div class="absolute inset-0 bg-gradient-to-t from-primary/5 via-transparent to-transparent pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Centered logo + brand -->
    <div class="flex flex-col items-center mb-10">
      <div class="flex items-center gap-3 mb-3">
        <img src="/icons/yggdrasil-logo.svg" alt="Yggdrasil" class="h-8 w-8" />
        <span class="text-xl font-bold text-gradient">Yggdrasil</span>
      </div>
      <p class="text-sm text-muted-foreground text-center max-w-md lang-en">
        Open source MCP Servers, SKILLs & PlugIns by Asgard AI Platform.
      </p>
      <p class="text-sm text-muted-foreground text-center max-w-md lang-zh">
        由 Asgard AI Platform 打造的開源 MCP 伺服器、技能與解決方案套件。
      </p>
    </div>

    <!-- Navigation links in a row -->
    <div class="flex flex-wrap justify-center gap-6 mb-10 text-sm">
      <a href="/mcp/" class="text-muted-foreground hover:text-primary transition-colors">
        <span class="lang-en">MCP Servers</span><span class="lang-zh">MCP 伺服器</span>
      </a>
      <a href="/skills/" class="text-muted-foreground hover:text-primary transition-colors">
        <span class="lang-en">SKILLs</span><span class="lang-zh">技能</span>
      </a>
      <a href="/plugins/" class="text-muted-foreground hover:text-primary transition-colors">
        <span class="lang-en">PlugIns</span><span class="lang-zh">解決方案</span>
      </a>
      <a href="/contribute/" class="text-muted-foreground hover:text-primary transition-colors">
        <span class="lang-en">Submit Listing</span><span class="lang-zh">申請上架</span>
      </a>
      <a href="https://github.com/asgard-ai-platform" target="_blank" rel="noopener" class="text-muted-foreground hover:text-primary transition-colors">GitHub</a>
    </div>

    <!-- Divider -->
    <div class="border-t border-border mb-6"></div>

    <!-- Copyright -->
    <div class="text-center text-xs text-muted-foreground space-y-1">
      <p>MIT License &copy; {new Date().getFullYear()} Asgard AI Platform</p>
      <p>
        <span class="lang-en">Built with love for the open source community</span><span class="lang-zh">用愛為開源社群打造</span>
      </p>
    </div>
  </div>
</footer>
