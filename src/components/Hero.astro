---
---
<section class="relative overflow-hidden py-24 sm:py-36">
  <!-- Animated background glows -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green-500/20 rounded-full blur-3xl animate-glow-pulse"></div>
    <div class="absolute top-1/3 right-1/4 w-80 h-80 bg-cyan-500/20 rounded-full blur-3xl animate-glow-pulse-delayed"></div>
    <div class="absolute bottom-1/4 left-1/2 w-72 h-72 bg-blue-500/15 rounded-full blur-3xl animate-glow-pulse-delayed-2"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Top badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-border bg-card/50 backdrop-blur-sm mb-8">
      <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
      <span class="text-xs font-medium text-muted-foreground">
        <span class="lang-en">Discover Open Source Excellence</span><span class="lang-zh">探索開源卓越</span>
      </span>
    </div>

    <!-- Logo -->
    <div class="flex justify-center mb-6">
      <img src="/icons/yggdrasil-logo.svg" alt="" class="h-20 w-20" />
    </div>

    <!-- Title with gradient text -->
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight">
      <span class="text-gradient">Yggdrasil</span>
    </h1>
    <p class="mt-3 text-lg sm:text-xl text-muted-foreground font-medium">
      <span class="lang-en">Asgard Open Source Gallery</span><span class="lang-zh">Asgard 開源展示廳</span>
    </p>

    <!-- Description with highlighted keywords -->
    <p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed lang-en">
      <span class="text-foreground font-medium">MCP Servers</span>,
      <span class="text-foreground font-medium">SKILLs</span> &
      <span class="text-foreground font-medium">Solution Bundles</span>
      for the AI-native enterprise
    </p>
    <p class="mt-6 text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed lang-zh">
      為 AI 原生企業打造的
      <span class="text-foreground font-medium">MCP 伺服器</span>、<span class="text-foreground font-medium">技能</span>與<span class="text-foreground font-medium">解決方案套件</span>
    </p>

    <!-- Pill badges -->
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <div class="flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-card/30 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-green-400"></span>
        <span class="text-sm text-muted-foreground">
          <span class="lang-en">100% Open Source</span><span class="lang-zh">100% 開源</span>
        </span>
      </div>
      <div class="flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-card/30 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span class="text-sm text-muted-foreground">
          <span class="lang-en">MCP Compatible</span><span class="lang-zh">MCP 相容</span>
        </span>
      </div>
      <div class="flex items-center gap-2 px-4 py-2 rounded-full border border-border bg-card/30 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span class="text-sm text-muted-foreground">
          <span class="lang-en">Community Driven</span><span class="lang-zh">社群驅動</span>
        </span>
      </div>
    </div>

    <!-- CTA buttons -->
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/mcp/" class="btn-gradient px-6 py-3 rounded-lg text-sm font-semibold">
        <span class="lang-en">Browse MCP Servers</span><span class="lang-zh">瀏覽 MCP 伺服器</span>
      </a>
      <a href="/skills/" class="px-6 py-3 border border-primary/30 text-primary rounded-lg text-sm font-medium hover:bg-primary/10 transition-colors">
        <span class="lang-en">Explore SKILLs</span><span class="lang-zh">探索技能</span>
      </a>
      <a href="/bundles/" class="px-6 py-3 border border-border text-muted-foreground rounded-lg text-sm font-medium hover:border-primary/30 hover:text-foreground transition-colors">
        <span class="lang-en">View Bundles</span><span class="lang-zh">查看解決方案</span>
      </a>
    </div>

    <!-- Supported by Asgard -->
    <div class="mt-14 flex items-center justify-center gap-3 opacity-60 hover:opacity-100 transition-opacity">
      <div class="h-px w-12 bg-border"></div>
      <a href="/ecosystem/" class="flex items-center gap-2.5 group">
        <div class="relative">
          <div class="absolute -inset-1 rounded-full bg-blue-500/0 group-hover:bg-blue-500/20 blur transition-all"></div>
          <img src="/icons/asgard-logo.svg" alt="Asgard" class="h-7 w-7 relative" />
        </div>
        <span class="text-sm text-muted-foreground group-hover:text-foreground transition-colors">
          <span class="lang-en">Supported by</span><span class="lang-zh">由</span>
          <span class="font-semibold text-foreground"> Asgard AI Platform</span>
          <span class="lang-zh"> 支持</span>
        </span>
      </a>
      <div class="h-px w-12 bg-border"></div>
    </div>
  </div>
</section>
