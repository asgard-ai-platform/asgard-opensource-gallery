---
import StatusBadge from './StatusBadge.astro';
import type { McpServer } from '../types';

interface Props {
  server: McpServer;
}

const { server } = Astro.props;
const descEn = server.description.en;
const descZh = server.description.zh || server.description.en;
const truncatedEn = descEn.length > 100 ? descEn.slice(0, 100) + '...' : descEn;
const truncatedZh = descZh.length > 100 ? descZh.slice(0, 100) + '...' : descZh;
const searchText = [
  server.name.en, server.name.zh, server.slug,
  descEn, descZh, server.tags?.join(' ') || '',
].join(' ').toLowerCase();

const gradientColors: Record<string, string> = {
  ecommerce: 'from-green-600 to-emerald-900',
  payment: 'from-cyan-600 to-teal-900',
  analytics: 'from-blue-600 to-indigo-900',
  communication: 'from-violet-600 to-purple-900',
  data: 'from-sky-600 to-blue-900',
  crm: 'from-pink-600 to-rose-900',
  restaurant: 'from-orange-600 to-amber-900',
  gov: 'from-slate-600 to-gray-900',
  marketing: 'from-fuchsia-600 to-pink-900',
  finance: 'from-emerald-600 to-green-900',
};
const gradient = gradientColors[server.category] || 'from-green-600 to-emerald-900';
const isReleased = server.status === 'released';
---

<a
  href={`/mcp/${server.slug}/`}
  class={`card-link group ${isReleased ? 'border-border' : 'border-border/50 opacity-60 hover:opacity-100 transition-opacity'}`}
  data-category={server.category}
  data-status={server.status}
  data-search={searchText}
>
  <!-- Icon/gradient header area -->
  <div class={`card-header ${gradient}`}>
    <div class="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent"></div>

    <div class="absolute top-3 right-3 z-10">
      <StatusBadge status={server.status} />
    </div>

    <div class="relative z-10">
      {server.icon ? (
        <img src={`/icons/${server.icon}`} alt="" class="h-16 w-16 rounded-xl" />
      ) : (
        <div class="card-icon-letter">{server.name.en.charAt(0)}</div>
      )}
    </div>
  </div>

  <!-- Card body -->
  <div class="relative p-5">
    <!-- Title -->
    <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors name-bilingual">
      <span class="name-en">{server.name.en}</span>
      <span class="name-zh">{server.name.zh}</span>
    </h3>

    <p class="card-desc lang-en">{truncatedEn}</p>
    <p class="card-desc lang-zh">{truncatedZh}</p>

    {server.tags && server.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {server.tags.slice(0, 3).map((tag) => (
          <span class="card-tag">{tag}</span>
        ))}
      </div>
    )}

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <span class="card-badge">{server.category}</span>
      <span class="card-badge">{server.region}</span>
      {server.status === 'released' && server.tools_count && (
        <span class="text-muted-foreground">
          {server.tools_count} <span class="lang-en">tools</span><span class="lang-zh">工具</span>
        </span>
      )}
      {server.maintainer && (
        <span class="ml-auto text-muted-foreground/70">by @{server.maintainer}</span>
      )}
    </div>
  </div>

  {server.upgrade_to && (
    <div class="px-5 pb-4 text-xs text-primary/70">
      &rarr; <span class="lang-en">Upgrade to</span><span class="lang-zh">升級至</span> {server.upgrade_to}
    </div>
  )}
</a>
