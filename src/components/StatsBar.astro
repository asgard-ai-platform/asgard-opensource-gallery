---
interface Props {
  mcpReleased: number;
  mcpTotal: number;
  skillReleased: number;
  skillTotal: number;
  pluginCount: number;
}

const { mcpReleased, mcpTotal, skillReleased, skillTotal, pluginCount } = Astro.props;

const stats = [
  {
    labelEn: 'MCP Servers', labelZh: 'MCP 伺服器',
    released: mcpReleased, total: mcpTotal,
    color: 'from-green-500/20 to-green-500/5',
  },
  {
    labelEn: 'SKILLs', labelZh: '技能',
    released: skillReleased, total: skillTotal,
    color: 'from-cyan-500/20 to-cyan-500/5',
  },
  {
    labelEn: 'PlugIns', labelZh: '解決方案套件',
    released: pluginCount, total: pluginCount,
    color: 'from-blue-500/20 to-blue-500/5',
  },
];
---

<section class="relative border-y border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-3 gap-6">
      {stats.map(({ labelEn, labelZh, released, total, color }) => (
        <div class={`relative overflow-hidden rounded-xl border border-border bg-gradient-to-br ${color} p-6 text-center`}>
          <div class="absolute inset-0 bg-primary/5 opacity-0 hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="text-4xl sm:text-5xl font-bold text-gradient">{released}</div>
            {total > released ? (
              <div class="mt-1 text-xs text-muted-foreground/60">
                / {total} <span class="lang-en">total</span><span class="lang-zh">總計</span>
              </div>
            ) : null}
            <div class="mt-2 text-sm text-muted-foreground">
              <span class="lang-en">{labelEn}</span><span class="lang-zh">{labelZh}</span>
            </div>
            <div class="mt-1 text-xs">
              <span class="inline-flex items-center gap-1 text-green-400">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span class="lang-en">released</span><span class="lang-zh">已發布</span>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
