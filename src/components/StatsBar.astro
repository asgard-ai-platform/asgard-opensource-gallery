---
interface Props {
  mcpCount: number;
  skillCount: number;
  pluginCount: number;
}

const { mcpCount, skillCount, pluginCount } = Astro.props;

const stats = [
  { labelEn: 'MCP Servers', labelZh: 'MCP 伺服器', value: mcpCount, color: 'from-green-500/20 to-green-500/5' },
  { labelEn: 'SKILLs', labelZh: '技能', value: skillCount, color: 'from-cyan-500/20 to-cyan-500/5' },
  { labelEn: 'PlugIns', labelZh: '解決方案套件', value: pluginCount, color: 'from-blue-500/20 to-blue-500/5' },
];
---

<section class="relative border-y border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-3 gap-6">
      {stats.map(({ labelEn, labelZh, value, color }) => (
        <div class={`relative overflow-hidden rounded-xl border border-border bg-gradient-to-br ${color} p-6 text-center`}>
          <!-- Glow effect -->
          <div class="absolute inset-0 bg-primary/5 opacity-0 hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="text-4xl sm:text-5xl font-bold text-gradient">{value}</div>
            <div class="mt-2 text-sm text-muted-foreground">
              <span class="lang-en">{labelEn}</span><span class="lang-zh">{labelZh}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
