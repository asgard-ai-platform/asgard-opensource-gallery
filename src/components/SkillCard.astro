---
import StatusBadge from './StatusBadge.astro';
import type { Skill } from '../types';

interface Props {
  skill: Skill;
}

const { skill } = Astro.props;
const descEn = skill.description.en;
const descZh = skill.description.zh || skill.description.en;
const truncatedEn = descEn.length > 100 ? descEn.slice(0, 100) + '...' : descEn;
const truncatedZh = descZh.length > 100 ? descZh.slice(0, 100) + '...' : descZh;
const searchDesc = (descEn + ' ' + descZh).toLowerCase();

const typeColors: Record<string, string> = {
  industry: 'text-primary',
  methodology: 'text-emerald-400',
  theory: 'text-purple-400',
  algorithm: 'text-orange-400',
};

const typeGradients: Record<string, string> = {
  industry: 'from-green-600 to-emerald-900',
  methodology: 'from-emerald-600 to-teal-900',
  theory: 'from-purple-600 to-indigo-900',
  algorithm: 'from-orange-600 to-amber-900',
};
const gradient = typeGradients[skill.skill_type] || 'from-green-600 to-emerald-900';
---

<a
  href={`/skills/${skill.slug}/`}
  class="card-hover group block bg-card border border-border rounded-xl overflow-hidden"
  data-category={skill.category}
  data-region={skill.region || 'global'}
  data-status={skill.status}
  data-skilltype={skill.skill_type}
  data-name={`${skill.name.en} ${skill.name.zh}`.toLowerCase()}
  data-slug={skill.slug}
  data-tags={skill.tags?.join(',') || ''}
  data-description={searchDesc}
>
  <!-- Gradient overlay on hover -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/0 to-primary/0 group-hover:from-primary/5 group-hover:to-transparent transition-all duration-500 rounded-xl pointer-events-none z-10"></div>

  <!-- Icon/gradient header area -->
  <div class={`relative h-40 bg-gradient-to-br ${gradient} flex items-center justify-center overflow-hidden`}>
    <div class="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent"></div>

    {skill.status === 'released' && (
      <div class="absolute top-3 right-3 z-10">
        <StatusBadge status={skill.status} />
      </div>
    )}

    <div class="relative z-10">
      {skill.icon ? (
        <img src={`/icons/${skill.icon}`} alt="" class="h-16 w-16 rounded-xl" />
      ) : (
        <div class="h-20 w-20 rounded-2xl bg-background/30 backdrop-blur-sm text-foreground flex items-center justify-center font-bold text-4xl border border-white/10">
          {skill.name.en.charAt(0)}
        </div>
      )}
    </div>
  </div>

  <!-- Card body -->
  <div class="relative p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors name-bilingual">
          <span class="name-en">{skill.name.en}</span>
          <span class="name-zh">{skill.name.zh}</span>
        </h3>
        <span class={`text-xs font-medium ${typeColors[skill.skill_type] || 'text-muted-foreground'}`}>
          {skill.skill_type}
        </span>
      </div>
      {skill.status !== 'released' && <StatusBadge status={skill.status} />}
    </div>

    <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2 lang-en">{truncatedEn}</p>
    <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2 lang-zh">{truncatedZh}</p>

    {skill.tags && skill.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {skill.tags.slice(0, 3).map((tag) => (
          <span class="px-2 py-0.5 text-xs rounded-full border border-border/40 text-muted-foreground">{tag}</span>
        ))}
      </div>
    )}

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <span class="px-2 py-0.5 bg-accent rounded text-muted-foreground">{skill.category}</span>
      {skill.has_script && (
        <span class="px-2 py-0.5 bg-primary/10 text-primary rounded">
          <span class="lang-en">Contains Script</span><span class="lang-zh">含腳本</span>
        </span>
      )}
      {skill.maintainer && (
        <span class="ml-auto text-muted-foreground/70">by @{skill.maintainer}</span>
      )}
    </div>

    {skill.requires_mcp && skill.requires_mcp.length > 0 && (
      <div class="mt-2 text-xs text-muted-foreground">
        <span class="lang-en">requires:</span><span class="lang-zh">需要：</span> {skill.requires_mcp.join(', ')}
      </div>
    )}

    <div class="mt-4">
      <span class="btn-gradient inline-block w-full text-center px-4 py-2 rounded-lg text-sm">
        <span class="lang-en">View Details</span><span class="lang-zh">查看詳情</span>
      </span>
    </div>
  </div>

  {skill.upgrade_to && (
    <div class="px-5 pb-4 text-xs text-primary/70">
      &rarr; <span class="lang-en">Upgrade to</span><span class="lang-zh">升級至</span> {skill.upgrade_to}
    </div>
  )}
</a>
