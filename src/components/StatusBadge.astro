---
interface Props {
  status: 'released' | 'coming-soon' | 'planned';
}

const { status } = Astro.props;

const styles: Record<string, string> = {
  released: 'bg-gradient-to-r from-green-500 to-emerald-500 text-black',
  'coming-soon': 'bg-status-coming text-black',
  planned: 'border border-muted-foreground/40 text-muted-foreground',
};

const labelsEn: Record<string, string> = {
  released: 'Released',
  'coming-soon': 'Coming Soon',
  planned: 'Planned',
};

const labelsZh: Record<string, string> = {
  released: '已發布',
  'coming-soon': '即將推出',
  planned: '規劃中',
};
---

<span class={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold ${styles[status]}`}>
  {status === 'released' && (
    <svg class="w-3 h-3" fill="currentColor" aria-hidden="true"><use href="#icon-star" /></svg>
  )}
  <span class="lang-en">{labelsEn[status]}</span><span class="lang-zh">{labelsZh[status]}</span>
</span>
