---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import UpgradeCTA from '../../components/UpgradeCTA.astro';
import McpCard from '../../components/McpCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getMcpServers, getPlugIns, getMcpContentBySlug } from '../../utils/data-loader';
import { renderMarkdown } from '../../utils/markdown';
import type { McpServer } from '../../types';

export function getStaticPaths() {
  const servers = getMcpServers();
  return servers.map((server) => ({
    params: { slug: server.slug },
    props: { server },
  }));
}

const { server } = Astro.props as { server: McpServer };
const allServers = getMcpServers();
const plugins = getPlugIns().filter((p) => server.plugins?.includes(p.slug));
const related = allServers
  .filter((s) => s.slug !== server.slug && s.category === server.category)
  .slice(0, 3);

const rawContent = getMcpContentBySlug(server.slug);

// Pre-render markdown sections for both languages
function renderSections(sections: Record<string, string> | undefined) {
  if (!sections) return {};
  const rendered: Record<string, string> = {};
  for (const [key, md] of Object.entries(sections)) {
    rendered[key] = renderMarkdown(md);
  }
  return rendered;
}

const detail = rawContent ? {
  intro: {
    en: rawContent.intro?.en ? renderMarkdown(rawContent.intro.en) : '',
    zh: rawContent.intro?.zh ? renderMarkdown(rawContent.intro.zh) : '',
  },
  en: renderSections(rawContent.sections?.en),
  zh: renderSections(rawContent.sections?.zh),
} : null;

// Section display config: key → { icon, labelEn, labelZh }
const sectionConfig: Record<string, { icon: string; labelEn: string; labelZh: string }> = {
  features: { icon: 'M13 10V3L4 14h7v7l9-11h-7z', labelEn: 'Features', labelZh: '功能特色' },
  api_reference: { icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', labelEn: 'API Reference', labelZh: 'API 參考文件' },
  quick_start: { icon: 'M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z', labelEn: 'Quick Start', labelZh: '快速開始' },
  available_tools: { icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z', labelEn: 'Available Tools', labelZh: '可用工具' },
  development: { icon: 'M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z', labelEn: 'Development', labelZh: '開發' },
  contributing: { icon: 'M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z', labelEn: 'Contributing', labelZh: '貢獻' },
  license: { icon: 'M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z', labelEn: 'License', labelZh: '授權' },
};
const sectionOrder = ['features', 'api_reference', 'quick_start', 'available_tools'];
---

<BaseLayout
  title={server.name.en}
  description={server.description.en}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": server.slug,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cross-platform",
      "url": server.github,
    })} />
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {/* Header */}
    <div class="flex items-start gap-4 mb-8">
      {server.icon ? (
        <img src={`/icons/${server.icon}`} alt="" class="h-16 w-16 rounded-xl" />
      ) : (
        <div class="h-16 w-16 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-2xl border border-border">
          {server.name.en.charAt(0)}
        </div>
      )}
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold text-foreground name-bilingual">
            <span class="name-en">{server.name.en}</span>
            <span class="name-zh">{server.name.zh}</span>
          </h1>
          <StatusBadge status={server.status} />
        </div>
        <div class="mt-2 flex flex-wrap gap-2 text-sm">
          <span class="px-2 py-0.5 bg-accent rounded text-muted-foreground">{server.category}</span>
          <span class="px-2 py-0.5 bg-accent rounded text-muted-foreground">{server.region}</span>
        </div>
      </div>
    </div>

    {/* Description — from YAML */}
    <section class="mb-8">
      <p class="text-foreground leading-relaxed lang-en">{server.description.en}</p>
      <p class="text-foreground leading-relaxed lang-zh">{server.description.zh}</p>
    </section>

    {/* Quick Info */}
    <section class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="glass-card rounded-lg p-4">
        <div class="text-xs text-muted-foreground uppercase tracking-wider">
          <span class="lang-en">Status</span><span class="lang-zh">狀態</span>
        </div>
        <div class="mt-1 font-medium text-foreground capitalize">{server.status.replace('-', ' ')}</div>
      </div>
      {server.tools_count && (
        <div class="glass-card rounded-lg p-4">
          <div class="text-xs text-muted-foreground uppercase tracking-wider">
            <span class="lang-en">Tools</span><span class="lang-zh">工具數</span>
          </div>
          <div class="mt-1 font-medium text-primary">{server.tools_count}</div>
        </div>
      )}
      <div class="glass-card rounded-lg p-4">
        <div class="text-xs text-muted-foreground uppercase tracking-wider">
          <span class="lang-en">Category</span><span class="lang-zh">分類</span>
        </div>
        <div class="mt-1 font-medium text-foreground capitalize">{server.category}</div>
      </div>
      <div class="glass-card rounded-lg p-4">
        <div class="text-xs text-muted-foreground uppercase tracking-wider">
          <span class="lang-en">Region</span><span class="lang-zh">地區</span>
        </div>
        <div class="mt-1 font-medium text-foreground capitalize">{server.region}</div>
      </div>
      {server.maintainer && (
        <div class="glass-card rounded-lg p-4">
          <div class="text-xs text-muted-foreground uppercase tracking-wider">
            <span class="lang-en">Maintainer</span><span class="lang-zh">維護者</span>
          </div>
          <div class="mt-1 font-medium">
            <a href={`https://github.com/${server.maintainer}`} target="_blank" rel="noopener" class="text-primary hover:underline">@{server.maintainer}</a>
          </div>
        </div>
      )}
    </section>

    {/* Links */}
    <section class="flex flex-wrap gap-4 mb-8">
      <a href={server.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2 glass-card rounded-lg text-sm text-foreground hover:border-primary/40 transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </a>
      {server.api_docs && (
        <a href={server.api_docs} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2 glass-card rounded-lg text-sm text-foreground hover:border-primary/40 transition-colors">
          <span class="lang-en">API Docs</span><span class="lang-zh">API 文件</span> &nearr;
        </a>
      )}
    </section>

    {/* ── Rich Content Sections (from README) ── */}
    {detail && (
      <div class="space-y-8 mb-8">
        {sectionOrder.map((key) => {
          const enHtml = detail.en[key];
          const zhHtml = detail.zh[key];
          const cfg = sectionConfig[key];
          if (!enHtml && !zhHtml) return null;
          return (
            <section class="skill-section">
              <h2 class="skill-section-title">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={cfg.icon} /></svg>
                <span class="lang-en">{cfg.labelEn}</span><span class="lang-zh">{cfg.labelZh}</span>
              </h2>
              {enHtml && <div class="skill-content lang-en" set:html={enHtml} />}
              {zhHtml ? (
                <div class="skill-content lang-zh" set:html={zhHtml} />
              ) : enHtml ? (
                <div class="skill-content lang-zh" set:html={enHtml} />
              ) : null}
            </section>
          );
        })}
      </div>
    )}

    {/* Tags */}
    {server.tags && server.tags.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-3">
          <span class="lang-en">Tags</span><span class="lang-zh">標籤</span>
        </h2>
        <div class="flex flex-wrap gap-2">
          {server.tags.map((tag) => (
            <span class="px-3 py-1 rounded-full text-sm border border-border/40 text-muted-foreground">{tag}</span>
          ))}
        </div>
      </section>
    )}

    {/* PlugIns */}
    {plugins.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-3">
          <span class="lang-en">Part of</span><span class="lang-zh">所屬</span>
        </h2>
        <div class="space-y-2">
          {plugins.map((p) => (
            <a href={`/plugins/${p.slug}/`} class="block glass-card rounded-lg p-4 hover:border-primary/40 transition-colors">
              <div class="font-medium text-foreground name-bilingual" style="flex-direction:row;gap:0.5rem;align-items:baseline;">
                <span class="name-en">{p.name.en}</span>
                <span class="name-zh">{p.name.zh}</span>
              </div>
              <div class="text-sm text-muted-foreground mt-1 lang-en">{p.description.en}</div>
              <div class="text-sm text-muted-foreground mt-1 lang-zh">{p.description.zh}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Upgrade CTA */}
    {server.upgrade_to && (
      <UpgradeCTA productName={server.upgrade_to} category={server.category} />
    )}

    {/* Related MCPs */}
    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xl font-bold mb-6 text-foreground">
          <span class="lang-en">Related MCP Servers</span><span class="lang-zh">相關 MCP 伺服器</span>
        </h2>
        <CardGrid>
          {related.map((s) => <McpCard server={s} />)}
        </CardGrid>
      </section>
    )}
  </div>
</BaseLayout>
