---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import UpgradeCTA from '../../components/UpgradeCTA.astro';
import McpCard from '../../components/McpCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import { getSkills, getMcpServers, getPlugIns, getSkillContentBySlug } from '../../utils/data-loader';
import { renderMarkdown } from '../../utils/markdown';
import { jsonLdScript } from '../../utils/jsonld';
import type { Skill } from '../../types';

export function getStaticPaths() {
  const skills = getSkills();
  return skills.map((skill) => ({
    params: { slug: skill.slug },
    props: { skill },
  }));
}

const { skill } = Astro.props as { skill: Skill };
const allMcp = getMcpServers();
const requiredMcp = allMcp.filter((m) => skill.requires_mcp?.includes(m.slug));
// Membership is derived from the plugin's skills[] (the source of truth in
// plugins.yaml); skill.plugins is honoured too for any entry that sets it.
const plugins = getPlugIns().filter(
  (p) => p.skills?.includes(skill.slug) || skill.plugins?.includes(p.slug),
);
const rawDetail = getSkillContentBySlug(skill.slug);

// Render each SKILL.md section to HTML at build time, in document order. Known
// section keys get an iconed bilingual header; any other section (e.g. the EMBA
// packs' Chinese-titled sections) renders under its original heading.
const sections = (rawDetail?.sections ?? [])
  .filter((s) => s.body)
  .map((s) => ({ key: s.key, title: s.title, html: renderMarkdown(s.body) }));

const frameworkLabel =
  skill.skill_type === 'algorithm'
    ? { en: 'Algorithm', zh: '演算法' }
    : skill.skill_type === 'methodology'
      ? { en: 'Methodology', zh: '方法論' }
      : { en: 'Framework', zh: '框架' };

// key → { bilingual label, heroicon path, warn? } for the standard sections.
const SECTION_META: Record<string, { en: string; zh: string; icon: string; warn?: boolean }> = {
  overview: { en: 'Overview', zh: '概述', icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  when_to_use: { en: 'When to Use', zh: '使用時機', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  when_not_to_use: { en: 'When NOT to Use', zh: '不適用時機', icon: 'M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636' },
  assumptions: { en: 'Assumptions', zh: '前提假設', icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4' },
  framework: { en: frameworkLabel.en, zh: frameworkLabel.zh, icon: 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z' },
  output_format: { en: 'Output Format', zh: '輸出格式', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  examples: { en: 'Examples', zh: '範例', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  gotchas: { en: 'Gotchas', zh: '注意事項', warn: true, icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z' },
  references: { en: 'References', zh: '參考資料', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
};
const DEFAULT_ICON = 'M4 6h16M4 12h16M4 18h7';

const typeColors: Record<string, string> = {
  industry: 'text-primary',
  methodology: 'text-emerald-400',
  theory: 'text-purple-400',
  algorithm: 'text-orange-400',
};
const typeGradients: Record<string, string> = {
  industry: 'from-green-500/20 to-emerald-500/20',
  methodology: 'from-emerald-500/20 to-teal-500/20',
  theory: 'from-purple-500/20 to-indigo-500/20',
  algorithm: 'from-orange-500/20 to-amber-500/20',
};
---

<BaseLayout title={skill.name.en} description={skill.description.en}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLdScript({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": skill.slug,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Cross-platform",
      "url": skill.github || `https://github.com/asgard-ai-platform/skills/blob/main/${skill.slug}/SKILL.md`,
    })} />
  </Fragment>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {/* Header */}
    <div class="flex items-start gap-4 mb-8">
      {skill.icon ? (
        <img src={`/icons/${skill.icon}`} alt="" class="h-16 w-16 rounded-xl" />
      ) : (
        <div class="h-16 w-16 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-bold text-2xl border border-border">
          {skill.name.en.charAt(0)}
        </div>
      )}
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold text-foreground name-bilingual">
            <span class="name-en">{skill.name.en}</span>
            <span class="name-zh">{skill.name.zh}</span>
          </h1>
          <StatusBadge status={skill.status} />
        </div>
        <div class="mt-2 flex flex-wrap gap-2 text-sm">
          <span class={`font-medium ${typeColors[skill.skill_type]}`}>{skill.skill_type}</span>
          <span class="px-2 py-0.5 bg-accent rounded text-muted-foreground">{skill.category}</span>
          {skill.has_script && (
            <span class="px-2 py-0.5 bg-primary/10 text-primary rounded">
              <span class="lang-en">Contains Script</span><span class="lang-zh">含腳本</span>
            </span>
          )}
        </div>
      </div>
    </div>

    {/* Description */}
    <section class="mb-8">
      <p class="text-foreground leading-relaxed lang-en">{skill.description.en}</p>
      <p class="text-foreground leading-relaxed lang-zh">{skill.description.zh}</p>
    </section>

    {/* Links */}
    {skill.github && (
      <section class="mb-8">
        <a href={skill.github} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2 glass-card rounded-lg text-sm text-foreground hover:border-primary/40 transition-colors">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span class="lang-en">View on GitHub</span><span class="lang-zh">在 GitHub 查看</span>
        </a>
      </section>
    )}

    {/* ── Rich Content Sections (from SKILL.md, document order) ── */}
    {sections.length > 0 && (
      <div class="space-y-8 mb-8">
        {sections.map((s) => {
          const meta = SECTION_META[s.key];
          return (
            <section class={`skill-section${meta?.warn ? ' skill-section-warn' : ''}`}>
              <h2 class="skill-section-title">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={meta?.icon ?? DEFAULT_ICON} /></svg>
                {meta ? (
                  <><span class="lang-en">{meta.en}</span><span class="lang-zh">{meta.zh}</span></>
                ) : (
                  <span>{s.title}</span>
                )}
              </h2>
              <div class="skill-content" set:html={s.html} />
            </section>
          );
        })}
      </div>
    )}

    {/* Tags */}
    {skill.tags && skill.tags.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-3">
          <span class="lang-en">Tags</span><span class="lang-zh">標籤</span>
        </h2>
        <div class="flex flex-wrap gap-2">
          {skill.tags.map((tag) => (
            <span class="px-3 py-1 rounded-full text-sm border border-border/40 text-muted-foreground">{tag}</span>
          ))}
        </div>
      </section>
    )}

    {/* Required MCPs */}
    {requiredMcp.length > 0 && (
      <section class="mb-8">
        <h2 class="text-xl font-bold mb-4 text-foreground">
          <span class="lang-en">Required MCP Servers</span><span class="lang-zh">所需 MCP 伺服器</span>
        </h2>
        <CardGrid>
          {requiredMcp.map((m) => <McpCard server={m} />)}
        </CardGrid>
      </section>
    )}

    {/* PlugIns */}
    {plugins.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-3">
          <span class="lang-en">Part of</span><span class="lang-zh">所屬</span>
        </h2>
        <div class="space-y-2">
          {plugins.map((p) => (
            <a href={`/plugins/${p.slug}/`} class="block glass-card rounded-lg p-4 hover:border-primary/40 transition-colors">
              <div class="font-medium text-foreground name-bilingual" style="flex-direction:row;gap:0.5rem;align-items:baseline;">
                <span class="name-en">{p.name.en}</span>
                <span class="name-zh">{p.name.zh}</span>
              </div>
              <div class="text-sm text-muted-foreground mt-1 lang-en">{p.description.en}</div>
              <div class="text-sm text-muted-foreground mt-1 lang-zh">{p.description.zh}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Upgrade CTA */}
    {skill.upgrade_to && (
      <UpgradeCTA productName={skill.upgrade_to} category={skill.category} />
    )}
  </div>
</BaseLayout>
